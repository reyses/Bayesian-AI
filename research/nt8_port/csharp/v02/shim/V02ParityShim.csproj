<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>v02shim</AssemblyName>
    <!-- P2-13 down-level proof: the shared core + this shim must compile at C# 7.3.
         LangVersion is independent of the target framework; a green build here means
         the region that ships in NinjaScript (NT8 .NET4.8 / old Roslyn) is 7.3-clean. -->
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- EnsembleCoreV02.gen.cs is generated by ../assemble.py from the canonical region. -->
</Project>
